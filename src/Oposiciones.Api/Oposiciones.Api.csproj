<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>oposiciones-tai-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oposiciones.Application\Oposiciones.Application.csproj" />
    <ProjectReference Include="..\Oposiciones.Domain\Oposiciones.Domain.csproj" />
    <ProjectReference Include="..\Oposiciones.Infrastructure\Oposiciones.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <!--
    El contenido versionado (temarios y banco de preguntas) viaja junto al binario publicado.
    Asi la Api arranca y responde sin base de datos ni pasos de instalacion adicionales.
  -->
  <ItemGroup>
    <Content Include="..\..\content\**\*.json"
             Link="content\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
